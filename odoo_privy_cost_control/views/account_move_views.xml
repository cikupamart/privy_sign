<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_privy_control" model="ir.ui.view">
        <field name="name">account.move.form.inherit.privy.control</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_to_privy" type="object" 
                        string="Kirim ke Privy" 
                        class="oe_highlight"
                        invisible="not use_privy_signature or privy_status in ['sent', 'signed']"
                        groups="account.group_account_manager"/>

                <button name="action_download_signed_document" type="object" 
                        string="Ambil PDF Signed" 
                        class="btn-secondary"
                        invisible="privy_status != 'signed'"
                        groups="account.group_account_manager"/>
            </xpath>

            <xpath expr="//field[@name='payment_reference']" position="after">
                <field name="use_privy_signature" groups="account.group_account_manager"/>
                <field name="privy_status" widget="badge" decoration-info="privy_status == 'sent'" decoration-success="privy_status == 'signed'" decoration-danger="privy_status == 'rejected'" invisible="not use_privy_signature"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Penandatangan Privy" name="privy_signers_page" invisible="not use_privy_signature">
                    <group>
                        <field name="privy_doc_token" readonly="1"/>
                    </group>
                    <field name="privy_signer_ids" mode="list">
                        <list editable="bottom" string="Daftar Penandatangan">
                            <field name="sequence" widget="handle"/>
                            <field name="partner_id"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="role_type"/>
                            <field name="signer_status" widget="badge" decoration-warning="signer_status == 'pending'" decoration-success="signer_status == 'signed'"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
